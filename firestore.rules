rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function aluEmail() {
      return signedIn() &&
        request.auth.token.email.lower().matches('.*@(alustudent|alueducation)\\.com');
    }
    function isStaff() {
      return verified() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }
    function validPhoto(url) {
      return url == null || url.matches('https://res\\.cloudinary\\.com/.*');
    }

    // ---------- users ----------
    match /users/{uid} {
      // you can only read your own profile
      allow read: if signedIn() && request.auth.uid == uid;

      // sign-up: own document, ALU email, role is forced to 'student'
      allow create: if signedIn()
        && request.auth.uid == uid
        && aluEmail()
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);

      // users may edit their name but can never change their own role
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      allow delete: if false;
    }

    // ---------- incidents ----------
    match /incidents/{incidentId} {
      allow read: if verified() && aluEmail();

      // students create reports only as themselves, always starting at 'Submitted'
      allow create: if verified() && aluEmail()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'Submitted'
        && request.resource.data.category in
             ['Facilities', 'Water', 'Electricity', 'Furniture', 'Sanitation', 'Safety']
        && request.resource.data.description.size() >= 10
        && validPhoto(request.resource.data.photoUrl)
        && request.resource.data.keys().hasOnly([
             'title', 'description', 'category', 'location', 'status', 'photoUrl',
             'reporterId', 'reporterName', 'anonymous',
             'createdAt', 'updatedAt', 'statusHistory']);

      // ONLY staff can update status, and ONLY the status-related fields
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'statusHistory'])
        && request.resource.data.status in
             ['Submitted', 'Under Review', 'In Progress', 'Resolved'];

      // owners can edit their own report's content while it is still 'Submitted'
      allow update: if verified() && aluEmail()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'Submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'category', 'location', 'photoUrl', 'updatedAt'])
        && request.resource.data.category in
             ['Facilities', 'Water', 'Electricity', 'Furniture', 'Sanitation', 'Safety']
        && request.resource.data.description.size() >= 10
        && validPhoto(request.resource.data.photoUrl);

      // owners can delete their own report only while it is still 'Submitted'
      allow delete: if verified()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'Submitted';
    }
  }
}
